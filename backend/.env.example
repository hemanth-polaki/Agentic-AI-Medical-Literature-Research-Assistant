# LLM API Keys (optional - system includes robust grounded biomedical extraction heuristics when no key is provided)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# NCBI Entrez PubMed API (optional - NCBI allows 3 requests/sec without key, 10 requests/sec with key)
PUBMED_API_KEY=
PUBMED_EMAIL=medresearch@agentic.ai

# Database configuration (PostgreSQL via postgresql+asyncpg://...)
# On Render: Auto-populated if using Render PostgreSQL, or paste Supabase/Neon connection URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/brightcone_db

# Redis caching (optional - in-memory fallback included automatically)
REDIS_URL=redis://localhost:6379/0

# App Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
# For Render in production, set to your Vercel URL (e.g. https://your-app.vercel.app) or "*"
CORS_ORIGINS=*

